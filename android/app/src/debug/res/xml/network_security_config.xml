<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
    Debug-only network security config.
    Allows cleartext (HTTP) for the Metro packager and local development networks,
    while still trusting the bundled custom CA + system CAs for HTTPS.
    The strict release config lives in src/main/res/xml/network_security_config.xml.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/ca" />
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">.local</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/ca" />
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
