<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: trust the custom CA for all HTTPS connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Custom CA certificate -->
            <certificates src="@raw/ca" />
            <!-- System CAs (needed for Firebase, third-party APIs, etc.) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext (HTTP) only for local network development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">.local</domain>
    </domain-config>

    <!-- Debug overrides: trust user-added CAs (for proxy debugging) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
