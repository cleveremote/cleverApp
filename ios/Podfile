require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# VisionCamera is used only for QR scanning (ScanBoxScreen). Frame processors would
# pull in Worklets, and the location APIs would force an NSLocationWhenInUse prompt
# on the camera — neither is needed.
$VCEnableFrameProcessors = false
$VCEnableLocation = false

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'cleverApp' do
  config = use_native_modules!
  pod 'Firebase', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  $RNFirebaseAsStaticFramework = true
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => true,
    )

    # Fix fmt 11 consteval errors with Apple Clang (Xcode 16 regression).
    # base.h enables FMT_USE_CONSTEVAL for __apple_build_version__ >= 14000029
    # but Apple Clang 16 has a bug with consteval constructors in templates.
    # Patch the condition to disable consteval for all Apple Clang builds.
    fmt_base_h = installer.sandbox.root.join('fmt/include/fmt/base.h').to_s
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      patched = content.sub(
        '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
        '#elif defined(__apple_build_version__)'
      )
      File.write(fmt_base_h, patched) if patched != content
    end

    # Disable Xcode 16 "Explicitly Built Modules". The clang dependency
    # scanner looks for pod .modulemap files in Build/Products before the
    # pods that generate them have been built, causing
    # "module map file ... not found" failures (e.g. FirebaseCoreInternal).
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |native_target|
        native_target.build_configurations.each do |config|
          config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end
      end
      aggregate_target.user_project.save
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end

      if target.name == 'react-native-slider'
        target.build_configurations.each do |config|
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/Headers/Public/React-RCTFabric"'
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/Headers/Private/React-Fabric"'
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/Headers/Private/React-RCTFabric"'
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/Headers/Private/React-graphics"'
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/Headers/Public/React-graphics"'
        end
      end
    end
  end
end